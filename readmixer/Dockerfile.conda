# Build from the repository root: docker build -f readmixer/Dockerfile.conda .
# This development image is not release-qualified.
FROM continuumio/miniconda3:latest
COPY . /app
WORKDIR /app
RUN conda env create -f readmixer/environment.yml
RUN conda run -n readmixer-env python -m pip install --no-deps .
ENTRYPOINT ["conda", "run", "--no-capture-output", "-n", "readmixer-env", "readmixer-py"]
